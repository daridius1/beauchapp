# ============================================
# Configuración de Beauchapp Backend
# ============================================
# Copia este archivo como .env y llena los valores.
# Luego usa: ./start.sh (en vez de ./pocketbase serve)

# URL Pública de la Aplicación (utilizada para enlaces en correos de verificación y contraseña)
# En producción ej: APP_URL=https://beauchapp.cl
APP_URL=https://beauchapp.cl

# Token de Resend (tu API key)
RESEND_API_KEY=re_xxxxxxxxxx

# (Opcional) Personalizar remitente de correos
SENDER_NAME=Beauchapp
SENDER_ADDRESS=no-reply@daridius.cl

# Cloudflare R2 (S3-compatible storage)
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# (Opcional) Notificación por Telegram cuando alguien reporta contenido o manda una sugerencia/bug.
# Si se dejan vacías, los reportes igual se guardan (revísalos en el dashboard de PocketBase, /_/),
# simplemente no llega el aviso a Telegram.
# 1. Habla con @BotFather en Telegram, /newbot, y copia el token que te da.
# 2. Escríbele algo a tu bot recién creado (o agrégalo a un grupo/canal) y consulta
#    https://api.telegram.org/bot<TOKEN>/getUpdates para encontrar tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
